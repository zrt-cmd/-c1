<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car1_app</name>
  <version>0.1.0</version>
  <description>Smart applications for car1 robot (line following, object tracking, hand gesture, grab)</description>
  <maintainer email="dev@example.com">developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>car1_servo_controller_msgs</exec_depend>
  <exec_depend>car1_kinematics</exec_depend>
  <exec_depend>car1_peripherals</exec_depend>
  <exec_depend>car1_bringup</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>car1_navigation</exec_depend>
  <exec_depend>car1_arm_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
