<?xml version="1.0" encoding="utf-8"?>
<robot name="car1" xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
    <xacro:arg name="prefix" default=""/>

    <!-- 引入基础 URDF -->
    <xacro:include filename="$(find car1_description)/urdf/car1.urdf"/>

    <!-- 引入 Gazebo 配置 -->
    <xacro:include filename="$(find car1_description)/gazebo/car1.gazebo.xacro"/>
    <xacro:include filename="$(find car1_description)/gazebo/car1.transmission.xacro"/>

    <!-- 引入 ros2_control 配置 -->
    <xacro:include filename="$(find car1_gazebo)/urdf/car1.gazebo.ros2_control.xacro"/>

    <!-- 应用 Gazebo 物理参数 -->
    <xacro:car1_gazebo prefix="$(arg prefix)"/>

    <!-- 应用 Transmission -->
    <xacro:car1_transmission prefix="$(arg prefix)"/>

    <!-- 应用 ros2_control -->
    <xacro:car1_gazebo_ros2_control name="GazeboSimSystem"/>

    <!-- Gazebo 插件 -->
    <gazebo>
        <!-- ros2_control 插件 -->
        <plugin filename="libgz_ros2_control-system.so"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find car1_gazebo)/config/ros2_controllers.yaml</parameters>
        </plugin>

        <!-- 关节状态发布器 -->
        <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
                name="ignition::gazebo::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>

        <!-- 四轮麦轮驱动，支持车体横移。 -->
        <plugin filename="gz-sim-mecanum-drive-system"
                name="gz::sim::systems::MecanumDrive">
            <front_left_joint>wheel_lf_joint</front_left_joint>
            <front_right_joint>wheel_rf_joint</front_right_joint>
            <back_left_joint>wheel_lb_joint</back_left_joint>
            <back_right_joint>wheel_rb_joint</back_right_joint>
            <wheel_separation>0.216</wheel_separation>
            <wheelbase>0.1946</wheelbase>
            <!-- Match the wheel collision sphere used by Gazebo physics. -->
            <wheel_radius>0.0488</wheel_radius>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>
    </gazebo>

    <!-- The URDF-to-SDF converter drops expressed_in; launch/mecanum_sdf.py restores it. -->
    <gazebo reference="wheel_lf_link">
        <mu1>1.0</mu1><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
    </gazebo>
    <gazebo reference="wheel_lb_link">
        <mu1>1.0</mu1><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
    </gazebo>
    <gazebo reference="wheel_rf_link">
        <mu1>1.0</mu1><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_footprint">1 1 0</fdir1>
    </gazebo>
    <gazebo reference="wheel_rb_link">
        <mu1>1.0</mu1><mu2>0.0</mu2>
        <fdir1 gz:expressed_in="base_footprint">1 -1 0</fdir1>
    </gazebo>

    <!-- 保留相机相关的 fixed joint，防止 Gazebo 合并 link -->
    <gazebo reference="camera_mount_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="camera_depth_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- 深度相机传感器 (安思疆 HP60C 参数) -->
    <gazebo reference="camera_depth_link">
        <sensor name="depth_camera" type="rgbd_camera">
            <topic>/camera</topic>
            <update_rate>20</update_rate>
            <camera>
                <horizontal_fov>1.288</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>4.0</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <!-- 2D 激光雷达 (COIN-D6 参数；gz-sim 仅支持 gpu_lidar) -->
    <gazebo reference="laser_link">
        <sensor name="lidar" type="gpu_lidar">
            <topic>/scan</topic>
            <gz_frame_id>laser_link</gz_frame_id>
            <update_rate>15</update_rate>
            <always_on>1</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.0943951</min_angle>
                        <max_angle>2.0943951</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>
