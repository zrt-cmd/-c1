<?xml version="1.0"?>
<!-- Kinematic holonomic proxy: same footprint and lidar pose as car1. -->
<sdf version="1.8">
  <model name="car1">
    <static>false</static>
    <link name="base_footprint">
      <kinematic>true</kinematic>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.36 0.27 0.2</size></box></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.36 0.27 0.2</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.75 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.146 0 0.366 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-2.0943951</min_angle>
              <max_angle>2.0943951</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <link_name>base_footprint</link_name>
      <topic>/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
