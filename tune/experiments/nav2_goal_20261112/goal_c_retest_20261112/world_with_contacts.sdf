      <static>true</static>
      <pose>-2.075 0.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.25 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.25 0.1 0.5</size></box></geometry>
