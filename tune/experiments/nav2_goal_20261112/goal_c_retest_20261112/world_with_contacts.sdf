<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">

  <world name="math_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.72 0.72 0.72 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>


    <model name="wall_north">
      <static>true</static>
      <pose>0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.5 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.5 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      <sensor name="wall_contact" type="contact"><contact><collision>collision</collision><topic>/reference_trial/contact/wall_north</topic></contact></sensor></link>
    </model>

    <model name="wall_south_left">
      <static>true</static>
      <pose>-1.65 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      <sensor name="wall_contact" type="contact"><contact><collision>collision</collision><topic>/reference_trial/contact/wall_south_left</topic></contact></sensor></link>
    </model>

    <model name="wall_south_right">
      <static>true</static>
      <pose>1.65 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      <sensor name="wall_contact" type="contact"><contact><collision>collision</collision><topic>/reference_trial/contact/wall_south_right</topic></contact></sensor></link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.7 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
